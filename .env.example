# LLM Provider Configuration
# Supported providers: "mock", "openai", "gemini"
LLM_PROVIDER=gemini

# Gemini Primary + Backup Credentials (PLACEHOLDERS ONLY - NEVER COMMIT REAL KEYS)
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=
GEMINI_API_KEY_BACKUP_3=
GEMINI_API_KEY_BACKUP_4=

GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_REQUEST_TIMEOUT_SECONDS=1.5
GEMINI_TOTAL_DEADLINE_SECONDS=4.0
GEMINI_MAX_ATTEMPTS=3

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
